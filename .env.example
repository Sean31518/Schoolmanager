# Kopieren nach .env und Werte anpassen. Secrets generieren z.B. mit: openssl rand -hex 32

PORT=6969
NODE_ENV=production

# SQLite-Datei innerhalb des Containers/Docker-Volumes
DATABASE_URL="file:/data/schulmanager.db"

# JWT-Secrets - UNBEDINGT vor dem ersten Start durch eigene Zufallswerte ersetzen
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Token-Lebensdauer
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Offene Registrierung erlauben (privates/familiäres Deployment)
ALLOW_REGISTRATION=true
