# Kopieren nach .env und Werte anpassen. Secrets generieren z.B. mit: openssl rand -hex 32

# Steuert sowohl den Port, auf dem die App im Container lauscht, als auch
# (via docker-compose.yml) den Host-Port, auf den er gemappt wird - z.B.
# nützlich, wenn 6969 bei dir schon belegt ist oder mehrere Instanzen
# laufen sollen. Nach einer Änderung: `docker compose up -d`.
PORT=6969
NODE_ENV=production

# SQLite-Datei innerhalb des Containers/Docker-Volumes. Achtung: nur der
# Pfad /data/... wird durch das Docker-Volume "schulmanager-data" dauerhaft
# gespeichert (siehe docker-compose.yml) - ein anderer Pfad hier bedeutet,
# dass du dort auch den Volume-Mount anpassen musst, sonst gehen die Daten
# beim nächsten Container-Neustart verloren.
DATABASE_URL="file:/data/schulmanager.db"

# Von Goodnotes gesicherte Hefte (PDFs) - im selben Docker-Volume wie die DB,
# es gilt dieselbe Warnung wie bei DATABASE_URL.
UPLOADS_DIR=/data/uploads

# JWT-Secrets - UNBEDINGT vor dem ersten Start durch eigene Zufallswerte ersetzen
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Token-Lebensdauer
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Offene Registrierung erlauben (privates/familiäres Deployment)
ALLOW_REGISTRATION=true

# Auf true setzen, wenn die App nur über HTTPS erreichbar ist (z.B. hinter
# einem Reverse Proxy mit TLS) - das Refresh-Token-Cookie wird dann nur
# noch über HTTPS übertragen. Bei reinem HTTP (kein Reverse Proxy, oder
# einer ohne TLS) muss das false bleiben, sonst funktioniert der Login
# nicht mehr.
COOKIE_SECURE=false

# Push-Benachrichtigungen (Erinnerungen an Klausuren/Hausaufgaben) - optional.
# Ohne diese drei Variablen bleibt die Funktion einfach deaktiviert
# ("Push-Benachrichtigungen sind auf diesem Server nicht eingerichtet."),
# der Rest der App läuft unverändert weiter. Voraussetzung fürs Aktivieren
# im Browser ist außerdem HTTPS (Service Worker verlangen einen sicheren
# Kontext) - z.B. über einen Reverse Proxy davor.
# Eigenes Schlüsselpaar erzeugen:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontaktadresse, die Push-Dienste (z.B. für Zustellprobleme) verwenden können.
VAPID_SUBJECT=mailto:admin@example.com

# Serverweiter Schlüssel zum Verschlüsseln von Drittanbieter-Zugangsdaten,
# die Nutzer in ihren Einstellungen hinterlegen (aktuell: IServ-Login fürs
# Vertretungsplan-Sync, siehe unten). Das ist NICHT das Zugangsdaten-Passwort
# selbst - das legt jeder Nutzer für sich in der App an. Ohne diesen
# Schlüssel bleibt die IServ-Anbindung einfach deaktiviert.
# Erzeugen mit: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# Goodnotes Auto-Backup per WebDAV. Eigener Port, an der Wurzel (/) -
# nur über einen Reverse Proxy mit HTTPS freigeben (Goodnotes verlangt
# das, und die Hefte gehen sonst unverschlüsselt durchs Netz), am besten
# nur aus dem Heimnetz. 0 schaltet den WebDAV-Server ab.
DAV_PORT=6970
# Die Adresse, die in Goodnotes eingetragen wird (nur zur Anzeige in den
# Einstellungen), z.B. https://schooldav.example.de/
DAV_PUBLIC_URL=
# Größte erlaubte Datei pro Upload in MB (Hefte mit vielen Bildern werden
# schnell 200 MB groß).
DAV_MAX_UPLOAD_MB=1024
