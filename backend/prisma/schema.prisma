datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// SQLite hat keine nativen Enum-Typen in Prisma - die zulässigen Werte werden
// stattdessen als String gespeichert und auf Anwendungsebene über zod validiert
// (siehe backend/src/lib/enums.ts):
// FederalState: BW BY BE BB HB HH HE MV NI NW RP SL SN ST SH TH
// Weekday: MONDAY TUESDAY WEDNESDAY THURSDAY FRIDAY SATURDAY SUNDAY
// TimeGridSlotType: LESSON BREAK
// CalendarEventType: MANUAL EXAM HOLIDAY PUBLIC_HOLIDAY
// FlashcardState: NEW LEARNING KNOWN
// DavFileKind: PDF OTHER
// Role: ADMIN USER - the first account ever created becomes ADMIN
// automatically (see auth.service.ts); everyone else is USER unless an
// admin creates their account through the admin panel.

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         String    @default("USER")
  // Bumped on every authenticated request (see authGuard) - the "zuletzt
  // online" an admin sees for each account. Null until the first request.
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  settings           Settings?
  subjects           Subject[]
  timeGridSlots      TimeGridSlot[]
  timetableSlots     TimetableSlot[]
  calendarEvents     CalendarEvent[]
  homework           Homework[]
  generalNotes       GeneralNote[]
  refreshTokens      RefreshToken[]
  pushSubscriptions  PushSubscription[]
  notificationLogs   NotificationLog[]
  timetableOverrides TimetableOverride[]
  appPasswords       AppPassword[]
  davFolders         DavFolder[]
  davFiles           DavFile[]
  documentLinks      DocumentLink[]
  flashcardDecks     FlashcardDeck[]
}

// Credentials Goodnotes uses for WebDAV (username = the account's email).
// A random, high-entropy token shown once at creation - stored only as a
// SHA-256 hash, which is safe for random tokens (nothing to brute-force)
// and cheap enough to check on each of the hundreds of requests a single
// Goodnotes backup run makes, unlike argon2.
model AppPassword {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// WebDAV collections, as Goodnotes creates them (empty ones too - it checks
// for each with PROPFIND and MKCOLs missing ones top-down). path is relative
// to the user's WebDAV root without leading/trailing slash, e.g.
// "GoodNotes/Schule/Abitur/Q1/Mathe". subjectId is a manual Fach assignment
// from "Ohne Fach"; it applies to this folder and everything below it.
model DavFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, path])
}

// One file in the WebDAV tree. kind: PDF = the "Hefte" the app shows and
// links to; OTHER = small non-PDF file whose bytes are kept (Goodnotes'
// backup-root marker); PLACEHOLDER = .goodnotes or other big non-PDF file -
// bytes discarded, only metadata kept, because Goodnotes PROPFINDs a file
// before MOVEing it on rename, so it has to keep looking present. A rename/move in Goodnotes arrives as a WebDAV MOVE and
// only changes path, so links (which point at the id) survive it.
model DavFile {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path       String
  kind       String
  size       Int
  sha256     String?
  // Goodnotes never deletes from its backup, so Hefte are hidden manually;
  // a new upload brings an archived Heft back.
  archived   Boolean  @default(false)
  modifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  versions DavFileVersion[]
  links    DocumentLink[]

  @@unique([userId, path])
  @@index([userId])
}

// Stored file content, newest = current. For PDFs only the last N
// (Settings.davVersionsToKeep) survive; an upload identical to the current
// version (same sha256) doesn't create a new one. pageFingerprints is a JSON
// array, one hash per page, used to re-find linked pages after pages were
// inserted. Parsing a big PDF is slow, so it happens in a background queue
// after the upload was answered - processedAt stays null until then.
// Small OTHER files (Goodnotes' .GoodnotesBackupRoot marker) keep one
// version with pageCount 0.
model DavFileVersion {
  id               String    @id @default(cuid())
  fileId           String
  file             DavFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  storagePath      String
  size             Int
  sha256           String
  pageCount        Int       @default(0)
  pageFingerprints String    @default("[]")
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([fileId])
  @@index([processedAt])
}

// A link from something in the app to a whole Heft (pageStart null) or a
// page range. fingerprintStart/End remember the linked pages' fingerprints
// so the range can be relocated when the Heft changes; uncertain is set
// when that relocation had to guess. Exactly one owner column is set.
model DocumentLink {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId           String
  file             DavFile        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  pageStart        Int?
  pageEnd          Int?
  fingerprintStart String?
  fingerprintEnd   String?
  uncertain        Boolean        @default(false)
  sortOrder        Int            @default(0)
  homeworkId       String?
  homework         Homework?      @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  calendarEventId  String?
  calendarEvent    CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  flashcardId      String?
  flashcard        Flashcard?     @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  generalNoteId    String?
  generalNote      GeneralNote?   @relation(fields: [generalNoteId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([userId])
  @@index([fileId])
  @@index([homeworkId])
  @@index([calendarEventId])
  @@index([flashcardId])
  @@index([generalNoteId])
}

// Single-row table (always id "singleton") for server-wide settings an
// admin manages from inside the app, as opposed to env vars a self-hoster
// sets at deploy time. Currently just the registration toggle.
model AppSettings {
  id                  String  @id @default("singleton")
  registrationEnabled Boolean @default(true)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// key identifies one specific reminder occasion, e.g. "exam:<calendarEventId>:3d"
// or "homework:<homeworkId>:1d" - checked before sending so a reminder is
// never pushed twice for the same thing.
model NotificationLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  sentAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Settings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentGradeLevel      Int      @default(5)
  currentSchoolYearLabel String?
  federalState           String   @default("BW")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // IServ-Anbindung (Vertretungsplan-Sync) - pro Nutzer, da jeder eigene
  // IServ-Zugangsdaten und ggf. eigene Kurse hat (Kursstufe). Passwort liegt
  // verschlüsselt vor (siehe lib/credentialsCrypto.ts), nie im Klartext in
  // der DB und nie an das Frontend zurückgegeben.
  iservHost              String?
  iservUsername          String?
  iservPasswordEncrypted String?
  // Klassenfilter für IServs Stundenplan-Endpunkt - optional, da Nutzer mit
  // individueller Kurswahl (Oberstufe) evtl. keinen sinnvollen hier haben.
  iservClass             String?
  // Ein/Aus-Schalter, unabhängig von den gespeicherten Zugangsdaten - lässt
  // den Sync pausieren, ohne Host/Benutzername/Passwort zu verlieren. Wenn
  // aktiv, ersetzt IServs Stundenplan (inkl. normaler, nicht vertretener
  // Stunden) den manuell gepflegten Plan für die synchronisierten Tage,
  // statt nur Vertretungen darüberzulegen.
  iservActive            Boolean   @default(false)
  iservLastSyncAt        DateTime?
  iservLastSyncError     String?
  // How many PDF versions per Heft to keep from Goodnotes uploads.
  davVersionsToKeep      Int       @default(3)
}

model Subject {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  color      String
  // Optionaler Kürzel-Hinweis für den IServ-Sync - manche Schulkürzel
  // (z.B. "bk3" für Bildende Kunst, "gm" für Gemeinschaftskunde) lassen sich
  // nicht algorithmisch aus dem Fachnamen ableiten, da sie keine Abkürzung
  // im Sinne eines Namens-Präfix sind. Wird vor der Präfix-Heuristik exakt
  // (case-insensitive) gegen IServs Rohkürzel geprüft.
  iservAlias String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  timetableSlots     TimetableSlot[]
  calendarEvents     CalendarEvent[]
  homework           Homework[]
  timetableOverrides TimetableOverride[]
  davFolders         DavFolder[]
  flashcardDecks     FlashcardDeck[]

  @@unique([userId, name])
  @@index([userId])
}

model FlashcardDeck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flashcards Flashcard[]

  @@index([userId])
  @@index([subjectId])
}

model Flashcard {
  id             String        @id @default(cuid())
  deckId         String
  deck           FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  question       String
  answer         String
  state          String        @default("NEW")
  sortOrder      Int           @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  links DocumentLink[]

  @@index([deckId])
}

model TimeGridSlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  type      String
  startTime String
  endTime   String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableSlots     TimetableSlot[]
  timetableOverrides TimetableOverride[]

  @@index([userId])
}

// Date-specific Vertretung (substitution) for a single TimeGridSlot on a
// single day, sourced from an IServ sync - separate from TimetableSlot
// (the recurring weekly template) since a Vertretung only applies once.
// A sync replaces every row for a given (userId, date) wholesale rather
// than merging, so a reverted substitution doesn't linger as a stale row.
model TimetableOverride {
  id                       String       @id @default(cuid())
  userId                   String
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                     DateTime
  timeGridSlotId           String
  timeGridSlot             TimeGridSlot @relation(fields: [timeGridSlotId], references: [id], onDelete: Cascade)
  // CANCELLED (entfällt) | CHANGED (Vertretung: anderes Fach/Raum) | NORMAL
  // (unveränderte Stunde, nur relevant wenn iservActive den manuellen Plan
  // ersetzt statt nur Vertretungen darüberzulegen)
  type                     String
  // Freitext-Anzeigename, immer gesetzt (außer bei CANCELLED, wo es keinen
  // "neuen" Namen gibt) - subjectId ist NUR gesetzt, wenn rawSubjectCode
  // tatsächlich zu einem lokalen Fach aufgelöst werden konnte (exakter
  // iservAlias-Treffer oder Präfix-Heuristik). Damit lässt sich die
  // Fach-Farbe direkt vom verknüpften Fach holen statt vom zufällig an
  // dieser Stelle manuell eingetragenen Fach, und die Detailansicht kann
  // "kein lokales Fach verknüpft" erkennen (subjectId null, rawSubjectCode
  // gesetzt) und einen "Fach anlegen"-Knopf anbieten.
  subjectName              String?
  subjectId                String?
  subject                  Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  // Der rohe IServ-Kürzel, aus dem subjectName/subjectId aufgelöst wurden -
  // zum Vorbefüllen von Name/IServ-Kürzel beim "Fach anlegen"-Knopf.
  rawSubjectCode           String?
  // room/teacherName/teacherAcronym are always the ORIGINAL/standard values
  // (from the base, non-substituted IServ entry) - never overwritten by a
  // substitution. The substitute* fields below are only set when a
  // substitution actually reports a *different* room/teacher, so the
  // frontend can show "original durchgestrichen, Vertretung daneben"
  // instead of silently swapping one value for the other.
  room                     String?
  substituteRoom           String?
  // Lehrkraft/Kurs/Zeiten aus IServ - für die Detailansicht im Stundenplan.
  startTime                String?
  endTime                  String?
  teacherName              String?
  teacherAcronym           String?
  substituteTeacherName    String?
  substituteTeacherAcronym String?
  courseName               String?
  note                     String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@unique([userId, date, timeGridSlotId])
  @@index([userId, date])
}

model TimetableSlot {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday        String
  timeGridSlotId String
  timeGridSlot   TimeGridSlot @relation(fields: [timeGridSlotId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  room           String?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, weekday, timeGridSlotId])
  @@index([userId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        String    @default("MANUAL")
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(true)
  // Plain "HH:mm" wall-clock strings, deliberately not folded into
  // startDate/endDate - this app (and its family) has exactly one
  // timezone, and storing time-of-day as an opaque string (same convention
  // as TimeGridSlot.startTime/endTime) sidesteps any UTC-vs-local
  // conversion entirely, which a real datetime value here would require
  // getting right on both server and client. Only meaningful when
  // allDay is false.
  startTime   String?
  endTime     String?
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  color       String?
  note        String?
  externalRef String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // For EXAM events these links are the Klausur's Lernstoff.
  links DocumentLink[]

  @@unique([userId, externalRef])
  @@index([userId, startDate])
}

model Homework {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  dueDate   DateTime?
  done      Boolean   @default(false)
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subtasks HomeworkSubtask[]
  links    DocumentLink[]

  @@index([userId, dueDate])
}

model HomeworkSubtask {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  title      String
  done       Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([homeworkId])
}

model GeneralNote {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  contentJson String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links DocumentLink[]

  @@index([userId])
}
