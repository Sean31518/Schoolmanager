datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// SQLite hat keine nativen Enum-Typen in Prisma - die zulässigen Werte werden
// stattdessen als String gespeichert und auf Anwendungsebene über zod validiert
// (siehe backend/src/lib/enums.ts):
// FederalState: BW BY BE BB HB HH HE MV NI NW RP SL SN ST SH TH
// Weekday: MONDAY TUESDAY WEDNESDAY THURSDAY FRIDAY SATURDAY SUNDAY
// TimeGridSlotType: LESSON BREAK
// CalendarEventType: MANUAL EXAM HOLIDAY PUBLIC_HOLIDAY
// FlashcardState: NEW LEARNING KNOWN

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings       Settings?
  subjects       Subject[]
  timeGridSlots  TimeGridSlot[]
  timetableSlots TimetableSlot[]
  calendarEvents CalendarEvent[]
  homework       Homework[]
  generalNotes   GeneralNote[]
  refreshTokens  RefreshToken[]
  uploadedFiles  UploadedFile[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
  timetableOverrides TimetableOverride[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// key identifies one specific reminder occasion, e.g. "exam:<calendarEventId>:3d"
// or "homework:<homeworkId>:1d" - checked before sending so a reminder is
// never pushed twice for the same thing.
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  sentAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Settings {
  id                     String       @id @default(cuid())
  userId                 String       @unique
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentGradeLevel      Int      @default(5)
  currentSchoolYearLabel String?
  federalState           String   @default("BW")
  createdAt              DateTime @default(now())
  updatedAt              DateTime     @updatedAt

  // IServ-Anbindung (Vertretungsplan-Sync) - pro Nutzer, da jeder eigene
  // IServ-Zugangsdaten und ggf. eigene Kurse hat (Kursstufe). Passwort liegt
  // verschlüsselt vor (siehe lib/credentialsCrypto.ts), nie im Klartext in
  // der DB und nie an das Frontend zurückgegeben.
  iservHost              String?
  iservUsername          String?
  iservPasswordEncrypted String?
  // Klassenfilter für IServs Stundenplan-Endpunkt - optional, da Nutzer mit
  // individueller Kurswahl (Oberstufe) evtl. keinen sinnvollen hier haben.
  iservClass             String?
  // Ein/Aus-Schalter, unabhängig von den gespeicherten Zugangsdaten - lässt
  // den Sync pausieren, ohne Host/Benutzername/Passwort zu verlieren. Wenn
  // aktiv, ersetzt IServs Stundenplan (inkl. normaler, nicht vertretener
  // Stunden) den manuell gepflegten Plan für die synchronisierten Tage,
  // statt nur Vertretungen darüberzulegen.
  iservActive            Boolean      @default(false)
  iservLastSyncAt        DateTime?
  iservLastSyncError     String?
}

model Subject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  // Optionaler Kürzel-Hinweis für den IServ-Sync - manche Schulkürzel
  // (z.B. "bk3" für Bildende Kunst, "gm" für Gemeinschaftskunde) lassen sich
  // nicht algorithmisch aus dem Fachnamen ableiten, da sie keine Abkürzung
  // im Sinne eines Namens-Präfix sind. Wird vor der Präfix-Heuristik exakt
  // (case-insensitive) gegen IServs Rohkürzel geprüft.
  iservAlias String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  noteSectionTypes NoteSectionType[]
  timetableSlots   TimetableSlot[]
  calendarEvents   CalendarEvent[]
  homework         Homework[]

  @@unique([userId, name])
  @@index([userId])
}

model NoteSectionType {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics Topic[]

  @@unique([subjectId, name])
  @@index([subjectId])
}

model Topic {
  id                String          @id @default(cuid())
  noteSectionTypeId String
  noteSectionType   NoteSectionType @relation(fields: [noteSectionTypeId], references: [id], onDelete: Cascade)
  name              String
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  notes       Note[]
  gradeLevels TopicGradeLevel[]
  flashcards  Flashcard[]

  @@index([noteSectionTypeId])
}

model Flashcard {
  id             String    @id @default(cuid())
  topicId        String
  topic          Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question       String
  answer         String
  state          String    @default("NEW")
  sortOrder      Int       @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([topicId])
}

model TopicGradeLevel {
  id         String @id @default(cuid())
  topicId    String
  topic      Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  gradeLevel Int

  @@unique([topicId, gradeLevel])
  @@index([topicId])
}

model Note {
  id           String    @id @default(cuid())
  topicId      String
  topic        Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title        String
  sortOrder    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  blocks        NoteBlock[]
  examPrepItems ExamPrepItem[]
  homework      Homework[]

  @@index([topicId])
}

// type: TEXT | PDF_PAGE | VIDEO | LINK (validiert in noteBlocks.schema.ts)
// TEXT nutzt contentJson (TipTap-Dokument), PDF_PAGE/VIDEO nutzen fileId
// (PDF_PAGE zusätzlich pageNumber, da jede Seite ein eigener Block ist -
// das erlaubt manuelles Einfügen von Textblöcken zwischen Seiten über den
// normalen Block-Reihenfolge-Mechanismus), LINK nutzt url.
model NoteBlock {
  id          String        @id @default(cuid())
  noteId      String
  note        Note          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  type        String
  sortOrder   Int           @default(0)
  contentJson String?
  fileId      String?
  file        UploadedFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  pageNumber  Int?
  url         String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([noteId])
  @@index([fileId])
}

model UploadedFile {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  createdAt    DateTime @default(now())

  blocks NoteBlock[]

  @@index([userId])
}

model TimeGridSlot {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  type      String
  startTime String
  endTime   String
  sortOrder Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  timetableSlots TimetableSlot[]
  timetableOverrides TimetableOverride[]

  @@index([userId])
}

// Date-specific Vertretung (substitution) for a single TimeGridSlot on a
// single day, sourced from an IServ sync - separate from TimetableSlot
// (the recurring weekly template) since a Vertretung only applies once.
// A sync replaces every row for a given (userId, date) wholesale rather
// than merging, so a reverted substitution doesn't linger as a stale row.
model TimetableOverride {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  timeGridSlotId String
  timeGridSlot   TimeGridSlot @relation(fields: [timeGridSlotId], references: [id], onDelete: Cascade)
  // CANCELLED (entfällt) | CHANGED (Vertretung: anderes Fach/Raum) | NORMAL
  // (unveränderte Stunde, nur relevant wenn iservActive den manuellen Plan
  // ersetzt statt nur Vertretungen darüberzulegen)
  type           String
  subjectName    String?
  room           String?
  // Lehrkraft/Kurs/Zeiten aus IServ - für die Detailansicht im Stundenplan;
  // stammen von der ursprünglich geplanten Stunde, nicht von einer eventuellen
  // Vertretung (deren genaue Feldnamen bei IServ noch nicht bestätigt sind).
  startTime      String?
  endTime        String?
  teacherName    String?
  teacherAcronym String?
  courseName     String?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, date, timeGridSlotId])
  @@index([userId, date])
}

model TimetableSlot {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday        String
  timeGridSlotId String
  timeGridSlot   TimeGridSlot @relation(fields: [timeGridSlotId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  room           String?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, weekday, timeGridSlotId])
  @@index([userId])
}

model CalendarEvent {
  id          String            @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        String    @default("MANUAL")
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean           @default(true)
  subjectId   String?
  subject     Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  color       String?
  note        String?
  externalRef String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  examPrepItems ExamPrepItem[]

  @@unique([userId, externalRef])
  @@index([userId, startDate])
}

model ExamPrepItem {
  id              String        @id @default(cuid())
  calendarEventId String
  calendarEvent   CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  noteId          String
  note            Note          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  sectionIndex    Int
  sectionLabel    String
  createdAt       DateTime      @default(now())

  @@unique([calendarEventId, noteId, sectionIndex])
  @@index([calendarEventId])
  @@index([noteId])
}

model Homework {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  subjectId    String?
  subject      Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  done         Boolean   @default(false)
  note         String?
  linkedNoteId String?
  linkedNote   Note?     @relation(fields: [linkedNoteId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subtasks HomeworkSubtask[]

  @@index([userId, dueDate])
  @@index([linkedNoteId])
}

model HomeworkSubtask {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  title      String
  done       Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([homeworkId])
}

model GeneralNote {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  contentJson String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
